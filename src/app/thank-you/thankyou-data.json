{"html": "<style>\n\n:root{--bg:#120b22;--bg2:#1a0f33;--card:#20143d;--line:rgba(212,175,106,.28);--gold:#d9b46c;--gold2:#f0d594;--cream:#f8f3ea;--ink:#1d1630;--mut:#b9afd0;--violet:#7a4fd0}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml{scroll-behavior:smooth}html,body{overflow-x:hidden}\nbody{font-family:Inter,system-ui,sans-serif;background:var(--bg);color:#fff;line-height:1.55;-webkit-font-smoothing:antialiased}\nh1,h2,h3{font-family:'Cormorant Garamond',serif;font-weight:600;line-height:1.08}\na{color:inherit;text-decoration:none}\n.wrap{max-width:1120px;margin:0 auto;padding:0 24px}\n.btn{display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border-radius:999px;font-weight:600;font-size:15px;cursor:pointer;border:1px solid transparent;transition:.2s}\n.btn.gold{background:linear-gradient(180deg,var(--gold2),var(--gold));color:#2a1c05;box-shadow:0 8px 28px rgba(217,180,108,.28)}\n.btn.gold:hover{transform:translateY(-2px);box-shadow:0 12px 34px rgba(217,180,108,.4)}\n.btn.ghost{border-color:var(--gold);color:#fff;background:rgba(255,255,255,.03)}\n.btn.ghost:hover{background:rgba(217,180,108,.12)}\n.eyebrow{font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:600}\n/* nav */\nnav{position:sticky;top:0;z-index:20;background:rgba(18,11,34,.82);backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,.06)}\nnav .wrap{display:flex;align-items:center;justify-content:space-between;height:74px;gap:20px}\n.logo{display:flex;align-items:center;gap:10px}\n.logo svg{width:34px;height:34px}\n.logo b{font-family:'Cormorant Garamond',serif;font-size:22px;letter-spacing:.05em;font-weight:600;display:block;line-height:1}\n.logo small{font-size:8.5px;letter-spacing:.2em;color:var(--mut);text-transform:uppercase}\nnav ul{display:flex;gap:26px;list-style:none;font-size:14px;color:#e8e0f6}\nnav ul a:hover{color:var(--gold)}\nnav .btn{padding:11px 22px;font-size:14px}\n\nbody{min-height:100vh;background:radial-gradient(900px 600px at 80% 0%,#4a2a86 0%,transparent 60%),radial-gradient(700px 500px at 0% 100%,#2b1654 0%,transparent 60%),var(--bg)}\nmain{padding:70px 0 80px;text-align:center}\n.check{width:76px;height:76px;border-radius:50%;margin:0 auto 24px;border:1.5px solid var(--gold);display:grid;place-items:center;background:rgba(217,180,108,.08)}\n.check svg{width:34px;height:34px;stroke:var(--gold);fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}\nh1{font-size:clamp(38px,6vw,68px);margin-bottom:14px}h1 em{font-style:normal;color:var(--gold)}\n.lead{color:#d9d0ee;max-width:560px;margin:0 auto 30px;font-size:17px}\n.cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:54px}\n.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;text-align:left;max-width:960px;margin:0 auto 34px}\n.step{background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:18px;padding:24px}\n.step b{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:linear-gradient(180deg,var(--gold2),var(--gold));color:#2a1c05;margin-bottom:12px}\n.step h3{font-family:Inter,sans-serif;font-size:16px;font-weight:600;margin-bottom:6px}\n.step p{color:var(--mut);font-size:14px}\n.note{max-width:640px;margin:0 auto;border:1px solid var(--line);border-radius:14px;padding:16px 20px;color:#d9d0ee;font-size:14px;background:rgba(217,180,108,.06)}\nfooter{padding:30px 0;text-align:center;font-size:12px;color:#8f84a8}\n@media(max-width:820px){.steps{grid-template-columns:1fr}}\n\n</style>\n<nav><div class=\"wrap\"><a class=\"logo\" href=\"https://app.trendhubusa.com/\"><svg viewBox=\"0 0 40 40\" fill=\"none\" stroke=\"#d9b46c\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6c3 5 3 12 0 18-3-6-3-13 0-18z\"/><path d=\"M20 24C14 24 8 19 6 12c6 0 11 3 14 12zM20 24c6 0 12-5 14-12-6 0-11 3-14 12z\"/><path d=\"M8 28c4 4 20 4 24 0\"/></svg><span><b>MANIFEST 2027 AI</b><small>Your mind. Your power. Your reality.</small></span></a></div></nav>\n<main><div class=\"wrap\">\n <div class=\"check\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></div>\n <h1>Thank You for Your <em>Purchase!</em></h1>\n <p class=\"lead\">Welcome to Manifest 2027 AI. Your journey of intention, clarity and personal growth starts here.</p>\n <div class=\"cta\"><a class=\"btn gold\" id=\"signup\" href=\"https://app.trendhubusa.com/signup\">Create Your Account \u2192</a><a class=\"btn ghost\" id=\"login\" href=\"https://app.trendhubusa.com/login\">Log In</a></div>\n <div class=\"steps\">\n  <div class=\"step\"><b>1</b><h3>Create your account or log in</h3><p>Use the same email address you used at checkout so your purchase can be matched to your account.</p></div>\n  <div class=\"step\"><b>2</b><h3>Open the app</h3><p>Sign in on your phone, tablet or computer. Your 21-day journey and AI guide are inside the app.</p></div>\n  <div class=\"step\"><b>3</b><h3>Read your ebook</h3><p>Your ebook, <i>Manifest Your 2027</i>, is available from your account once your purchase is confirmed.</p></div>\n </div>\n <p class=\"note\">Access is activated after your payment is confirmed by our payment processor, Hotmart. This usually takes a few minutes. If you don't see your access yet, check your purchase email, then contact support with your order number.</p>\n</div></main>\n<footer>\u00a9 2026 Manifest 2027 AI. For reflection and personal growth; not medical, financial or legal advice.</footer>", "js": "var LINKS={login:\"https://app.trendhubusa.com/login\",signup:\"https://app.trendhubusa.com/signup\"};\ndocument.getElementById('signup').href=LINKS.signup;document.getElementById('login').href=LINKS.login;"}